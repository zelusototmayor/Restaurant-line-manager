<div class="relative mx-auto max-w-6xl">
  <div class="pointer-events-none absolute -top-16 right-8 h-56 w-56 rounded-full bg-amber-200/60 blur-3xl float-soft"></div>
  <div class="pointer-events-none absolute bottom-4 left-0 h-64 w-64 rounded-full bg-emerald-200/50 blur-3xl float-soft"></div>

  <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
    <div class="space-y-8 fade-up">
      <div class="space-y-4">
        <span class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 px-4 py-2 text-xs font-semibold uppercase tracking-[0.15em] text-amber-800 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          Guest View
        </span>
        <h1 class="text-4xl font-semibold leading-tight text-slate-900 sm:text-5xl lg:text-[3.25rem] text-balance">
          Keep your line moving and your lobby calm.
        </h1>
        <p class="text-lg leading-relaxed text-slate-600 text-balance max-w-xl">
          Restaurant Line Manager turns walk-ins into a smooth, predictable flow. See queue health, live tables, and accurate wait windows in seconds.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/queue" class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-slate-800 hover:shadow-lg">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          Host Queue Console
        </a>
        <a href="/live" class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white/80 px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-white hover:text-slate-900">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          Live Table View
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/70 bg-white/90 p-4 shadow-sm transition hover:shadow-md">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">
            <svg class="h-3.5 w-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Occupancy
          </div>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @stats[:occupancy_rate] %>%</p>
          <p class="mt-1 text-xs text-slate-500"><%= @stats[:free_tables] %> tables free</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/90 p-4 shadow-sm transition hover:shadow-md">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">
            <svg class="h-3.5 w-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            In Queue
          </div>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @waiting_parties.count %></p>
          <p class="mt-1 text-xs text-slate-500"><%= @waiting_parties.sum { |p| p[:party_size] } %> people waiting</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/90 p-4 shadow-sm transition hover:shadow-md">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            Total Tables
          </div>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @stats[:total_tables] %></p>
          <p class="mt-1 text-xs text-slate-500"><%= @stats[:occupied_tables] %> occupied</p>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl border border-slate-200/70 bg-white/80 p-4">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900">Guest-friendly updates</p>
              <p class="mt-1 text-sm text-slate-600">Clear wait windows keep guests informed.</p>
            </div>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200/70 bg-white/80 p-4">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900">Real-time host view</p>
              <p class="mt-1 text-sm text-slate-600">See table status and pace every turn.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative fade-up fade-up-delay-1">
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-br from-amber-200/70 via-white/70 to-emerald-200/70 blur-2xl"></div>
      <div class="relative rounded-3xl border border-white/70 bg-white/95 p-6 shadow-xl sm:p-8">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Waitlist</p>
            <h2 class="mt-1 text-2xl font-semibold text-slate-900">Join the line</h2>
          </div>
          <% if @stats[:occupancy_rate] >= 80 %>
            <span class="rounded-full bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-800">BUSY</span>
          <% elsif @stats[:free_tables] > 5 %>
            <span class="rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-semibold text-emerald-800">OPEN</span>
          <% else %>
            <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">MODERATE</span>
          <% end %>
        </div>

        <%= form_with url: queue_add_path, method: :post, class: "space-y-4", data: { turbo: false } do |f| %>
          <p class="text-sm text-slate-600">Your party receives an anonymous queue number. No name is required.</p>

          <div>
            <label for="party_size" class="block text-sm font-semibold text-slate-700 mb-2">
              Party size
            </label>
            <select name="party_size" id="party_size" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-200">
              <% (1..12).each do |size| %>
                <option value="<%= size %>" <%= 'selected' if size == 2 %>><%= size %> <%= size == 1 ? 'person' : 'people' %></option>
              <% end %>
            </select>
          </div>

          <button type="submit" class="w-full rounded-xl bg-amber-500 px-6 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-amber-600 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-amber-300 focus:ring-offset-2">
            Join waitlist
          </button>
        <% end %>

        <div class="mt-6 border-t border-slate-200/80 pt-6">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Just checking?</p>
          <%= form_with url: estimate_path, method: :post, class: "flex flex-col gap-3 sm:flex-row sm:items-center", data: { turbo: false } do |f| %>
            <select name="party_size" id="estimate_party_size" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-200 sm:w-36">
              <% (1..12).each do |size| %>
                <option value="<%= size %>" <%= 'selected' if size == 2 %>><%= size %> <%= size == 1 ? 'person' : 'people' %></option>
              <% end %>
            </select>
            <button type="submit" class="w-full rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900 sm:flex-1">
              Check estimated wait
            </button>
          <% end %>
          <p class="mt-4 text-center text-xs text-slate-400">Demo data refreshes periodically</p>
        </div>
      </div>
    </div>
  </div>
</div>
