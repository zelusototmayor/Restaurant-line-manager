<div class="mx-auto max-w-4xl fade-up">
  <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8">
    <div class="rounded-2xl border border-white/70 bg-white/95 p-6 shadow-xl sm:p-8">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <span class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-amber-800">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
          Guest View
        </span>
        <a href="/queue" class="text-xs font-semibold text-slate-400 transition hover:text-slate-600">View full queue</a>
      </div>

      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-emerald-600">Success</p>
          <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">You're in line!</h1>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-slate-900 px-5 py-6 text-center text-white shadow-lg sm:px-6 sm:py-8">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">Your queue number</p>
        <p class="mt-3 text-5xl font-bold sm:text-6xl">#<%= @entry[:queue_number] %></p>
        <div class="mt-4 flex items-center justify-center gap-2 text-sm text-white/80">
          <span class="font-semibold"><%= @entry[:party_label] %></span>
          <span class="text-white/40">|</span>
          <span>Party of <%= @entry[:party_size] %></span>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-2xl border border-white/70 bg-white/95 p-5 shadow-lg">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <span class="text-sm font-semibold text-slate-600">Position in line</span>
          <span class="text-2xl font-bold text-slate-900">#<%= @position %></span>
        </div>
        <div class="flex items-center justify-between pt-4">
          <span class="text-sm font-semibold text-slate-600">Estimated wait</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1.5 text-sm font-semibold text-emerald-700">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <%= @entry[:eta_min] %>-<%= @entry[:eta_max] %> min
          </span>
        </div>
        <% if @position > 1 %>
          <div class="mt-4 border-t border-slate-100 pt-4 text-sm text-slate-600">
            <span class="font-semibold text-slate-900"><%= @position - 1 %></span> <%= @position - 1 == 1 ? 'party' : 'parties' %> ahead of you
          </div>
        <% else %>
          <div class="mt-4 border-t border-slate-100 pt-4">
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              You're next in line!
            </span>
          </div>
        <% end %>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <div class="flex gap-3">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-amber-900">Stay nearby</p>
            <p class="mt-1 text-sm text-amber-800/80">Keep your number visible. We'll call when your table is ready.</p>
          </div>
        </div>
      </div>

      <div class="space-y-2.5">
        <a href="/queue" class="flex w-full items-center justify-center gap-2 rounded-xl bg-amber-500 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-amber-600">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
          View full waitlist
        </a>
        <a href="/" class="flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
          Back to home
        </a>
      </div>
    </div>
  </div>
</div>
