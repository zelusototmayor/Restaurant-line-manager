<div class="mx-auto max-w-2xl fade-up">
  <div class="rounded-2xl border border-white/70 bg-white/95 p-6 shadow-xl sm:p-8">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <span class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-amber-800">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
        Guest View
      </span>
      <a href="/queue" class="text-xs font-semibold text-slate-400 transition hover:text-slate-600">Host console</a>
    </div>

    <% if @result[:success] %>
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Wait Estimate</p>
        <h1 class="mt-1 text-2xl font-semibold text-slate-900 sm:text-3xl">Estimated Wait Time</h1>
        <p class="mt-2 text-slate-600">For a party of <span class="font-semibold"><%= @party_size %></span></p>
      </div>

      <div class="mt-6 rounded-2xl bg-emerald-50 p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-emerald-700">Estimated</p>
        <p class="mt-2 text-4xl font-bold text-emerald-800 sm:text-5xl"><%= @result[:eta_min] %>-<%= @result[:eta_max] %> min</p>
      </div>

      <div class="mt-5 rounded-xl border border-slate-200/70 bg-slate-50 px-4 py-3">
        <div class="flex gap-3">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-sm text-slate-600"><%= @result[:message] %></p>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
        <a href="/" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-amber-500 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-amber-600">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Join Waitlist
        </a>
        <a href="/live" class="flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          Live Status
        </a>
      </div>

    <% else %>
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-rose-100 text-rose-600">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Wait Estimate</p>
        <h1 class="mt-1 text-2xl font-semibold text-slate-900 sm:text-3xl">Unable to Estimate</h1>
        <p class="mt-2 text-rose-600"><%= @result[:error] %></p>
      </div>

      <div class="mt-6">
        <a href="/" class="flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-slate-800">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8 8 0 116.582 6.582M20 4v5h-5"></path></svg>
          Try Again
        </a>
      </div>
    <% end %>
  </div>
</div>
